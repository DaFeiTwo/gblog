---
import { type CollectionEntry, getCollection } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import BlogComments from '@components/blog/BlogComments'
import Image from '@components/ui/images/Image.astro'
// import { timeago } from '@support/time'
import { Settings } from '../../config'
import { formatDateTime } from '@support/time'
import { SITE } from '@/config'
import markdownToc from 'markdown-toc'



export async function getStaticPaths() {
    const posts = await getCollection('posts')
    return posts.map(post => ({
        params: { slug: post.slug },
        props: post,
    }))
}

type Props = CollectionEntry<'posts'>

const post = Astro.props
const { Content, remarkPluginFrontmatter } = await post.render()

// 获取原始 Markdown 内容
const rawContent = post.body

// 使用 markdown-toc 生成目录
const toc = markdownToc(rawContent)
const headings = toc.json.map((item: any) => ({
    depth: item.lvl,
    slug: item.slug,
    text: item.content
}))

// 报错原因：pop后可能返回undefined，而这里定义的category不能是undefined；所以需要确保category总是一个有效的对象
// const category: CollectionEntry<'categories'> = (await getCollection('categories')).filter(
//     c => c.slug === post.data.category,
// ).pop() 

const category = (await getCollection('categories')).filter(
    c => c.slug === post.data.category
).pop() ?? { id: '', render: async () => ({}), slug: '', body: '', collection: 'categories', data: { title: '', description: '' } };

const tags = post.data.tags ?? [category.slug]
const URL = Astro.url.href
const ogImage = post.data.ogImage

// const pubDate = new Date(post.data.pubDate);
// const formattedDate = pubDate.toLocaleString('zh-CN', {
//     year: 'numeric',
//     month: '2-digit',
//     day: '2-digit',
//     hour: '2-digit',
//     minute: '2-digit',
//     second: '2-digit',
//     hour12: false, // 24小时制
// }).replace(/\//g, '-');
// const relativeTime = timeago(post.data.pubDate); //显示为几天前
---

<BaseLayout
    title={post.data.title}
    description={post.data.description}
    ogImage={ogImage}
    structuredData={{
        '@context': 'https://schema.org',
        '@type': 'NewsArticle',
        '@id': URL,
        'url': URL,
        'description': post.data.description,
        'image': [
            // post.data.banner,
        ],
        'headline': post.data.title,
        'datePublished': post.data.pubDate,
        'dateModified': post.data.pubDate,
        'author': [{
            '@type': 'Person',
            'name': SITE.author,
            'url': SITE.url,
        }],
    }}
>
    <div class="relative">
        <section class="mx-auto max-w-6xl px-4 pb-12 pt-8 sm:px-6 lg:px-8 lg:pt-12">
            <div class="shadow-none sm:shadow-sm mt-4 sm:mt-0">
                <!-- 博客首页图片 -->
                <div class="max-w-6xl">
                    <Image
                        class="w-full object-cover rounded-tl-sm rounded-tr-sm"
                        src={post.data.banner}
                        alt={post.data.title}
                        draggable="false"
                        format="avif"
                        loading="lazy"
                        inferSize={true}
                    />
                </div>
                <div class="sm:dark:bg-neutral-900/30 sm:bg-neutral-100 px-0 sm:px-6 md:px-10 lg:px-14 py-6">
                    <div class="mb-10">
                        <h2 class="block text-balance text-3xl font-bold tracking-tight text-neutral-800 dark:text-neutral-300 md:text-4xl lg:text-5xl">
                            {post.data.title}
                        </h2>
                        <ol class="flex items-center whitespace-nowrap mt-2">
                            <li class="inline-flex items-center">
                                <a
                                    class="flex items-center text-sm text-orange-400 hover:text-orange-500 focus:outline-none focus:text-orange-500"
                                    href=`/categories/${category.slug}`
                                >
                                    {category?.data?.title}
                                </a>
                                <svg
                                    class="flex-shrink-0 size-5 text-neutral-500 dark:text-neutral-600 mx-2"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 16 16"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                    aria-hidden="true"
                                >
                                    <path d="M6 13L10 3" stroke="currentColor" stroke-linecap="round"></path>
                                </svg>
                            </li>
                            <li class="inline-flex items-center text-sm text-neutral-500 hover:text-neutral-600 focus:outline-none focus:text-neutral-600 dark:text-neutral-500 dark:hover:text-neutral-400 dark:focus:text-neutral-400">
                                <!-- {timeago(post.data.pubDate)} -->
                                <!-- {post.data.pubDate}({timeago(post.data.pubDate)}) -->
                                {formatDateTime(post.data.pubDate)}
                                <!-- ({relativeTime}) -->
                                <svg
                                    class="flex-shrink-0 size-5 text-neutral-500 dark:text-neutral-600 mx-2"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 16 16"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                    aria-hidden="true"
                                >
                                    <path d="M6 13L10 3" stroke="currentColor" stroke-linecap="round"></path>
                                </svg>
                            </li>
                            <li
                                class="inline-flex items-center text-sm text-neutral-500 hover:text-neutral-600 focus:outline-none focus:text-neutral-600 dark:text-neutral-500 dark:hover:text-neutral-400 dark:focus:text-neutral-400"
                                aria-current="page"
                            >
                                {remarkPluginFrontmatter.minutesRead}
                            </li>
                        </ol>
                    </div>

                    <article class="prose prose-blog sm:prose-lg dark:prose-invert max-w-none">
                        <Content />
                    </article>

                    <div class="mt-10 md:mt-14 mx-auto grid max-w-screen-lg gap-y-5 sm:flex sm:items-center sm:justify-between sm:gap-y-0">
                        <div class="flex flex-wrap gap-x-2 gap-y-1 sm:flex-nowrap sm:items-center sm:gap-y-0">
                            {
                                tags.map((tag: string) => (
                                    <a
                                        href={`/tags/${tag}`}
                                        class="inline-flex items-center gap-x-2 text-sm text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-300"
                                    >
                                        <span class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-full text-xs font-medium bg-neutral-100 text-neutral-900 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700">
                                            {tag}
                                        </span>
                                    </a>
                                ))
                            }
                        </div>
                        <!-- <div class="flex items-center justify-end gap-x-1.5">-->
                        <!--    <Bookmark />-->
                        <!--    <div class="mx-3 block h-4 border-e border-neutral-400 dark:border-neutral-500"></div>-->
                        <!--    <div class="inline-flex">-->
                        <!--        <SocialShare pageTitle={post.data.title} />-->
                        <!--    </div>-->
                        <!--</div> -->
                    </div>
                </div>
            </div>

            {Settings.Comment.enable && (
                <div class="my-10">
                    <BlogComments client:only="react" />
                </div>
            )}
        </section>

        <!-- 目录 -->
        <div class="hidden xl:block fixed top-[7.5rem] right-[max(1rem,calc((100vw-102rem)/2))] w-[15rem]">
            <div class="h-full">
                <div class="bg-white/80 dark:bg-neutral-900/50 backdrop-blur-sm p-5 rounded-xl" 
                     style="max-height: calc(100vh - 32rem); height: auto;">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-medium text-neutral-500 dark:text-neutral-400 uppercase tracking-wider cursor-pointer hover:text-orange-500 transition-colors duration-200"
                            onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
                            目录
                        </h3>
                    </div>
                    <div id="toc-content" class="space-y-0 overflow-y-auto" style="max-height: calc(100vh - 36rem);">
                        {headings && headings.length > 0 ? (
                            headings.map((heading) => (
                                <a
                                    href={`#${heading.slug}`}
                                    data-toc-link
                                    data-heading-id={heading.slug}
                                    class={`
                                        toc-link block py-1.5 text-[13px] leading-relaxed transition-all duration-200
                                        border-l-2 border-transparent
                                        ${heading.depth === 1 ? 'pl-0 font-medium' : ''}
                                        ${heading.depth === 2 ? 'pl-3' : ''}
                                        ${heading.depth === 3 ? 'pl-6' : ''}
                                        ${heading.depth === 4 ? 'pl-9' : ''}
                                        ${heading.depth === 5 ? 'pl-12' : ''}
                                        ${heading.depth === 6 ? 'pl-15' : ''}
                                        text-neutral-600 dark:text-neutral-400
                                        hover:text-orange-500 dark:hover:text-orange-400
                                        hover:border-orange-500/30
                                    `}
                                >
                                    <span class="block truncate">
                                        {heading.text}
                                    </span>
                                </a>
                            ))
                        ) : (
                            <p class="text-sm text-neutral-400 dark:text-neutral-500">暂无目录</p>
                        )}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // 目录项点击滚动效果
        document.querySelectorAll('[data-toc-link]').forEach(anchor => {
            anchor.addEventListener('click', (e) => {
                e.preventDefault();
                const targetId = anchor.getAttribute('href')?.slice(1);
                const targetElement = document.getElementById(targetId || '');
                if (targetElement) {
                    const headerOffset = 100;
                    const elementPosition = targetElement.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

                    window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                    });
                }
            });
        });

        // 滚动监听 - 高亮当前阅读位置
        const observerOptions = {
            rootMargin: '-100px 0px -66%',
            threshold: 0
        };

        const headingElements = Array.from(document.querySelectorAll('article h1, article h2, article h3, article h4, article h5, article h6'));
        const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const id = entry.target.id;
                    
                    // 移除所有高亮
                    tocLinks.forEach(link => {
                        link.classList.remove('toc-active');
                        link.classList.add('border-transparent');
                        link.classList.remove('border-orange-500', 'text-orange-500', 'dark:text-orange-400', 'font-medium');
                    });

                    // 添加当前高亮
                    const activeLink = tocLinks.find(link => link.getAttribute('data-heading-id') === id);
                    if (activeLink) {
                        activeLink.classList.add('toc-active');
                        activeLink.classList.remove('border-transparent');
                        activeLink.classList.add('border-orange-500', 'text-orange-500', 'dark:text-orange-400', 'font-medium');
                        
                        // 滚动到可见区域
                        const tocContent = document.getElementById('toc-content');
                        if (tocContent) {
                            const linkTop = activeLink.offsetTop;
                            const linkHeight = activeLink.offsetHeight;
                            const containerHeight = tocContent.clientHeight;
                            const scrollTop = tocContent.scrollTop;

                            if (linkTop < scrollTop || linkTop + linkHeight > scrollTop + containerHeight) {
                                tocContent.scrollTo({
                                    top: linkTop - containerHeight / 2 + linkHeight / 2,
                                    behavior: 'smooth'
                                });
                            }
                        }
                    }
                }
            });
        }, observerOptions);

        headingElements.forEach(heading => {
            if (heading.id) {
                observer.observe(heading);
            }
        });

        // 目录滚动处理
        const tocContent = document.getElementById('toc-content');
        if (tocContent) {
            tocContent.addEventListener('wheel', (e) => {
                e.stopPropagation();
                const delta = e.deltaY;
                tocContent.scrollTop += delta;
                
                if (
                    (tocContent.scrollTop === 0 && delta < 0) || 
                    (tocContent.scrollTop + tocContent.clientHeight === tocContent.scrollHeight && delta > 0)
                ) {
                    e.preventDefault();
                }
            });
        }
    </script>

    <style is:inline>
        html.dark .astro-code,
        html.dark .astro-code span {
            color: var(--shiki-dark) !important;
            background-color: var(--shiki-dark-bg) !important;
        }

        /* 目录滚动条样式 - 少数派风格 */
        #toc-content {
            scrollbar-width: thin;
            scrollbar-color: rgba(155, 155, 155, 0.3) transparent;
        }

        #toc-content::-webkit-scrollbar {
            width: 4px;
        }

        #toc-content::-webkit-scrollbar-track {
            background: transparent;
        }

        #toc-content::-webkit-scrollbar-thumb {
            background-color: rgba(155, 155, 155, 0.3);
            border-radius: 2px;
            transition: background-color 0.2s;
        }

        #toc-content::-webkit-scrollbar-thumb:hover {
            background-color: rgba(155, 155, 155, 0.5);
        }

        html.dark #toc-content::-webkit-scrollbar-thumb {
            background-color: rgba(155, 155, 155, 0.2);
        }

        html.dark #toc-content::-webkit-scrollbar-thumb:hover {
            background-color: rgba(155, 155, 155, 0.4);
        }

        /* 目录链接样式 */
        .toc-link {
            position: relative;
        }

        .toc-link::before {
            content: '';
            position: absolute;
            left: -1px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: transparent;
            transition: background 0.2s ease;
        }

        .toc-link.toc-active::before {
            background: rgb(249 115 22);
        }

        /* 响应式布局 */
        @media (min-width: 1280px) {
            .right-\[max\(1rem\,calc\(\(100vw-90rem\)\/2\)\)\] {
                right: max(1rem, calc((100vw - 90rem)/2));
            }
        }

        @media (min-width: 1536px) {
            .right-\[max\(1rem\,calc\(\(100vw-90rem\)\/2\)\)\] {
                right: calc((100vw - 90rem)/2 + 1rem);
            }
        }

        /* 标题滚动偏移 */
        :target {
            scroll-margin-top: 100px;
        }

        /* 提示框样式 */
        .prose .custom-block {
            margin: 1rem 0;
            padding: 1rem 1.5rem;
            border-radius: 0.5rem;
            background-color: rgb(241 245 249 / 0.8);
            border: 1px solid rgb(226 232 240 / 1);
        }

        .prose .custom-block.info {
            background-color: rgb(240 249 255 / 0.8);
            border: 1px solid rgb(186 230 253 / 1);
        }

        html.dark .prose .custom-block.info {
            background-color: rgb(30 58 138 / 0.15);
            border: 1px solid rgb(59 130 246 / 0.2);
        }

        .prose .custom-block p {
            margin: 0;
            line-height: 1.5;
        }

        .prose .custom-block p:first-of-type {
            margin-top: 0;
        }

        .prose .custom-block p:last-of-type {
            margin-bottom: 0;
        }
    </style>
</BaseLayout>
