---
// 首页 热力图
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '@support/time'

const posts: CollectionEntry<'posts'>[] = (await getCollection('posts'))
const postsData = posts.map(post => ({
  date: formatDate(post.data.pubDate),
  wordCount: post.body.length,
  title: post.data.title,
  url: `/posts/${post.slug}/` 
}));
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
  <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
    <h2 class="text-3xl font-bold text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight">
      Blog Heat Map
    </h2>
    <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
      Visualizing my writing journey through time
    </p>
  </div>
  
  <div class="rounded-xl p-6 sm:p-8">
    <div id="heatmap" class="w-full" style="height: 300px;"></div>
  </div>
</section>
<!-- 通过CDN引入echarts -->
<script src="https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js"></script>
<script define:vars={{ postsData }}>
  window.addEventListener('DOMContentLoaded', function() {
    var chartDom = document.getElementById('heatmap');
    if (!chartDom || !window.echarts) return;
    var myChart = window.echarts.init(chartDom);

    // 处理文章数据，按日期统计字数
    const dateMap = new Map();
    postsData.forEach(post => {
      const dateStr = post.date;
      const existing = dateMap.get(dateStr) || { wordCount: 0, titles: [], urls: [] };
      dateMap.set(dateStr, {
        wordCount: existing.wordCount + post.wordCount,
        title: post.title,  // 保留最新标题
        url: post.url      // 添加URL字段
      });
    });

    // 获取最大字数，用于设置visualMap的范围
    const maxWordCount = Math.max(...Array.from(dateMap.values()).map(item => item.wordCount));

    // 转换为热力图数据格式
    const dataArr = Array.from(dateMap).map(([date, { wordCount }]) => {
      return [date, wordCount];
    });

    // 计算日期范围
    function heatmap_width(months){
        var startDate = new Date();
        var mill = startDate.setMonth((startDate.getMonth() - months));
        var endDate = +new Date();
        startDate = +new Date(mill);
        endDate = echarts.format.formatTime('yyyy-MM-dd', endDate);
        startDate = echarts.format.formatTime('yyyy-MM-dd', startDate);
        var showmonth = [];
        showmonth.push([
            startDate,
            endDate
        ]);
        return showmonth
    };

    function getRangeArr() {
        const windowWidth = window.innerWidth;
        if (windowWidth >= 600) {
          return heatmap_width(12);
        }
        else if (windowWidth >= 400) {
          return heatmap_width(9);
        }
        else {
          return heatmap_width(6);
        }
    }
    
    // 检测是否为深色模式
    const isDarkMode = document.documentElement.classList.contains('dark');
    
    const option = {
      visualMap: {
        type: 'piecewise',
        min: 0,
        max: maxWordCount,
        orient: 'horizontal',
        left: 'center',
        top: 20,
        pieces: [
          {min: 1, max: 1000, color: '#fed7aa', label: '< 1k'},
          {min: 1001, max: 3000, color: '#fb923c', label: '1k - 3k'},
          {min: 3001, max: 6000, color: '#f97316', label: '3k - 6k'},
          {min: 6001, color: '#ea580c', label: '> 6k'}
        ],
        textStyle: {
          color: isDarkMode ? '#a3a3a3' : '#737373',
          fontSize: 12
        },
        itemGap: 12,
        itemWidth: 18,
        itemHeight: 18,
        selectedMode: 'multiple'  // 使用多选模式，通过事件控制单选行为
      },
      tooltip: {
        formatter: function (params) {
          const post = dateMap.get(params.data[0]);
          const isDark = document.documentElement.classList.contains('dark');
          const titleColor = isDark ? '#e5e5e5' : '#262626';
          const dateColor = isDark ? '#a3a3a3' : '#737373';
          const countColor = isDark ? '#fb923c' : '#ea580c';
          
          return `<div style="padding: 8px 12px;">
            <div style="font-weight: 600; margin-bottom: 4px; color: ${titleColor};">${post.title}</div>
            <div style="color: ${dateColor}; font-size: 13px;">${params.data[0]}</div>
            <div style="color: ${countColor}; font-size: 13px; margin-top: 4px;">${post.wordCount.toLocaleString()} 字</div>
          </div>`;
        },
        backgroundColor: isDarkMode ? '#262626' : '#ffffff',
        borderColor: isDarkMode ? '#404040' : '#e5e5e5',
        borderWidth: 1,
        textStyle: {
          color: isDarkMode ? '#e5e5e5' : '#262626'
        },
        extraCssText: 'box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); border-radius: 8px;'
      },
      calendar: {
        top: 90,
        left: 60,
        right: 40,
        bottom: 20,
        cellSize: ['auto', 14],
        range: getRangeArr(),
        itemStyle: {
          borderWidth: isDarkMode ? 2 : 3,
          borderColor: isDarkMode ? '#2d3748' : '#f5f5f5',
          color: isDarkMode ? '#1f2937' : '#fafafa'
        },
        yearLabel: {
          show: true,
          fontSize: 14,
          fontWeight: 600,
          color: isDarkMode ? '#a3a3a3' : '#737373'
        },
        dayLabel: {
          firstDay: 1,
          nameMap: ['日', '一', '', '三', '', '五', ''],
          fontSize: 12,
          color: isDarkMode ? '#a3a3a3' : '#737373'
        },
        monthLabel: {
          nameMap: [
            '1月', '2月', '3月', '4月', '5月', '6月',
            '7月', '8月', '9月', '10月', '11月', '12月'
          ],
          fontSize: 13,
          fontWeight: 500,
          color: isDarkMode ? '#a3a3a3' : '#737373'
        },
        splitLine: {
          show: true,
          lineStyle: {
            color: isDarkMode ? '#4b5563' : '#e5e5e5',
            width: 2
          }
        }
      },
      series: {
        type: 'heatmap',
        coordinateSystem: 'calendar',
        data: dataArr,
        emphasis: {
          itemStyle: {
            shadowBlur: 10,
            shadowColor: isDarkMode ? 'rgba(251, 146, 60, 0.5)' : 'rgba(234, 88, 12, 0.5)'
          }
        }
      }
    };

    myChart.setOption(option);

    // 添加图例点击事件监听 - 实现单选模式
    let isAllSelected = true; // 标记是否处于全选状态
    
    myChart.on('legendselectchanged', function(params) {
      const clickedName = params.name;
      
      // 如果当前是全选状态，点击后切换到只选中当前项
      if (isAllSelected) {
        const newSelected = {
          '< 1k': clickedName === '< 1k',
          '1k - 3k': clickedName === '1k - 3k', 
          '3k - 6k': clickedName === '3k - 6k',
          '> 6k': clickedName === '> 6k'
        };
        
        myChart.setOption({
          visualMap: {
            selected: newSelected
          }
        });
        
        isAllSelected = false;
      } else {
        // 如果已经是单选状态，点击其他项就切换到该项
        const newSelected = {
          '< 1k': clickedName === '< 1k',
          '1k - 3k': clickedName === '1k - 3k', 
          '3k - 6k': clickedName === '3k - 6k',
          '> 6k': clickedName === '> 6k'
        };
        
        myChart.setOption({
          visualMap: {
            selected: newSelected
          }
        });
      }
    });

    // 添加热力图点击事件监听（跳转到文章）
    myChart.on('click', function(params) {
      if (params.componentType === 'series') {
        const post = dateMap.get(params.data[0]);
        const link = window.location.origin + post.url;
        window.open(link, '_blank').focus();
      }
    });
    
    // 监听主题变化并重新渲染图表
    window.addEventListener('on-hs-appearance-change', function(e) {
      const isDark = e.detail === 'dark';
      
      // 更新颜色配置
      option.visualMap.textStyle.color = isDark ? '#a3a3a3' : '#737373';
      option.calendar.itemStyle.borderWidth = isDark ? 2 : 3;
      option.calendar.itemStyle.borderColor = isDark ? '#2d3748' : '#f5f5f5';
      option.calendar.itemStyle.color = isDark ? '#1f2937' : '#fafafa';
      option.calendar.yearLabel.color = isDark ? '#a3a3a3' : '#737373';
      option.calendar.dayLabel.color = isDark ? '#a3a3a3' : '#737373';
      option.calendar.monthLabel.color = isDark ? '#a3a3a3' : '#737373';
      option.calendar.splitLine.lineStyle.color = isDark ? '#4b5563' : '#e5e5e5';
      option.calendar.splitLine.lineStyle.width = 2;
      option.series.emphasis.itemStyle.shadowColor = isDark ? 'rgba(251, 146, 60, 0.5)' : 'rgba(234, 88, 12, 0.5)';
      option.tooltip.backgroundColor = isDark ? '#262626' : '#ffffff';
      option.tooltip.borderColor = isDark ? '#404040' : '#e5e5e5';
      option.tooltip.textStyle.color = isDark ? '#e5e5e5' : '#262626';
      
      // 重新应用配置
      myChart.setOption(option);
    });

    // 响应式调整
    window.addEventListener('resize', function() {
      myChart.resize();
      const newRange = getRangeArr();
      option.calendar.range = newRange;
      myChart.setOption(option);
    });

  });
</script>


